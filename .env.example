# Variables de Entorno de Ejemplo para el Asistente Médico de Dengue
# Copia este archivo a .env y asigna los valores correspondientes. NUNCA subas .env al repositorio.

# Entorno de la aplicación (development | production)
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# API de Google Gemini (Obtén tu API key en Google AI Studio o Vertex AI)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Rutas de Persistencia Local (o montura en Cloud Run)
CHROMA_PERSIST_DIR=data/chroma
GEOSALUD_DATA_PATH=data/geosalud_ecuador.json

# Parámetros de Recuperación RAG
RELEVANCE_THRESHOLD=0.75
TOP_K_CHUNKS=4
